# Refugee Registry — Standalone Local Configuration Example
# Copy to .env and replace all CHANGE_ME values before starting services.

# Paths
OPENG2P_DEVELOPER_DIR=/path/to/openg2p-developer
REFUGEE_REGISTRY_DIR=.
REFUGEE_ENV_DIR=./deploy/local/env

# Pinned OpenG2P Registry Platform image tag
RP_VERSION=0.0.0-develop.716
REFUGEE_MASTER_DATA_API_IMAGE=openg2p/master-data-api:develop
REFUGEE_REGISTRY_STAFF_API_IMAGE=openg2p-refugee-registry-staff-api:0.0.0-develop.716
REFUGEE_REGISTRY_CELERY_IMAGE=openg2p-refugee-registry-celery:0.0.0-develop.716
REFUGEE_REGISTRY_STAFF_UI_IMAGE=openg2p-farmer-custom-staff-ui:0.0.0-develop.716
REFUGEE_REGISTRY_DB_SEED_IMAGE=openg2p-refugee-registry-db-seed:0.0.0-develop.716

# Host Ports (defaults match current local setup)
REFUGEE_REGISTRY_UI_PORT=3050
REFUGEE_REGISTRY_STAFF_API_PORT=8071
REFUGEE_MASTER_DATA_API_PORT=8049
REFUGEE_POSTGRES_PORT=5435
REFUGEE_REDIS_PORT=6381
REFUGEE_KEYCLOAK_PORT=8180
REFUGEE_IAM_STAFF_PORT=8120
REFUGEE_AWE_API_PORT=8130
REFUGEE_ID_GENERATOR_PORT=8140

# Databases
REFUGEE_REGISTRY_DB=refugee_registry_db
REFUGEE_MASTER_DATA_DB=refugee_master_data_db
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Isolated Keycloak / IAM / AWE / MinIO
REFUGEE_KEYCLOAK_REALM=refugee
REFUGEE_KEYCLOAK_CLIENT_ID=refugee-registry-staff-portal
REFUGEE_KEYCLOAK_ADMIN=admin
REFUGEE_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_IAM_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_AWE_RESOLVER_CLIENT_SECRET=CHANGE_ME
AWE_CALLBACK_SECRET_ID=CHANGE_ME
AWE_REGISTRY_CALLBACK_HMAC_SECRET=CHANGE_ME
AWE_CALLBACK_CALLER_SERVICE=refugee
APPROVER_RESOLVER_SECRET=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Master Data Country Pack
MASTER_DATA_COUNTRY_PACK=ETH
MASTER_DATA_PACK_DOMAINS=refugee
LOAD_SAMPLE_DATA=true
