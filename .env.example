# Standalone Refugee Registry Configuration
# Run ./scripts/init-env.sh to create .env with generated secrets.

COMPOSE_PROJECT_NAME=refugee-registry
RP_VERSION=0.0.0-develop.716
LOAD_SAMPLE_DATA=true

# Host Ports (non-colliding defaults)
REFUGEE_UI_PORT=3150
REFUGEE_STAFF_API_PORT=8271
REFUGEE_MDS_API_PORT=8249
REFUGEE_POSTGRES_PORT=5535
REFUGEE_REDIS_PORT=6481
REFUGEE_KEYCLOAK_PORT=8280
REFUGEE_IAM_PORT=8220
REFUGEE_AWE_PORT=8230
REFUGEE_IDGEN_PORT=8240
REFUGEE_MINIO_PORT=9100
REFUGEE_MINIO_CONSOLE_PORT=9101

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
REFUGEE_REGISTRY_DB=refugee_registry_db
REFUGEE_MASTER_DATA_DB=refugee_master_data_db

# MinIO Object Storage
MINIO_ROOT_USER=refugeeadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_NAME=default_bucket

# Keycloak
REFUGEE_KEYCLOAK_REALM=refugee
REFUGEE_KEYCLOAK_ADMIN=admin
REFUGEE_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
REFUGEE_KEYCLOAK_CLIENT_ID=refugee-registry-staff-portal
KEYCLOAK_IAM_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_AWE_RESOLVER_CLIENT_SECRET=CHANGE_ME
REFUGEE_DEMO_USER_PASSWORD=CHANGE_ME

# AWE Webhook & Resolver Secrets
AWE_CALLBACK_SECRET_ID=00000000-0000-4000-8000-000000000005
AWE_CALLBACK_HMAC_SECRET=CHANGE_ME
AWE_CALLBACK_CALLER_SERVICE=refugee
APPROVER_RESOLVER_SECRET=CHANGE_ME
