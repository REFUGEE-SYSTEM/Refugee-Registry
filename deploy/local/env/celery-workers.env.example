REGISTRY_EXTENSION_MODULE="openg2p_registry_refugee_extension"

REGISTRY_CELERY_WORKERS_DB_USERNAME="postgres"
REGISTRY_CELERY_WORKERS_DB_PASSWORD="CHANGE_ME"
REGISTRY_CELERY_WORKERS_DB_HOSTNAME="postgres"
REGISTRY_CELERY_WORKERS_DB_PORT=5432
REGISTRY_CELERY_WORKERS_DB_DBNAME="refugee_registry_db"

REGISTRY_CELERY_WORKERS_CELERY_BROKER_URL="redis://refugee-redis:6379/7"
REGISTRY_CELERY_WORKERS_CELERY_BACKEND_URL="redis://refugee-redis:6379/7"
REGISTRY_CELERY_WORKERS_WORKER_QUEUE="refugee_registry_worker_queue"

REGISTRY_CELERY_WORKERS_BATCH_SIZE=2000
REGISTRY_CELERY_WORKERS_WORKER_MAX_ATTEMPTS=5

REGISTRY_CELERY_WORKERS_MINIO_ENDPOINT="minio:9000"
REGISTRY_CELERY_WORKERS_MINIO_ACCESS_KEY="CHANGE_ME"
REGISTRY_CELERY_WORKERS_MINIO_SECRET_KEY="CHANGE_ME"
REGISTRY_CELERY_WORKERS_MINIO_SECURE=false
REGISTRY_CELERY_WORKERS_MINIO_BUCKET_NAME="templates"

REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DRIVER="postgresql+asyncpg"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_USERNAME="postgres"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PASSWORD="CHANGE_ME"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_HOSTNAME="postgres"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PORT=5432
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DBNAME="refugee_master_data_db"

REGISTRY_CELERY_WORKERS_FUNCTIONAL_ID_GENERATION_URL="http://refugee-id-generator:8000/v1"
REGISTRY_CELERY_WORKERS_ID_GENERATION_ALLOCATION_PATH="/idgenerator/{id_type}/id"
REGISTRY_CELERY_WORKERS_ID_GENERATION_UPDATION_PATH=""
